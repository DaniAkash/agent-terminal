{
  "name": "agent-terminal-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "src-tauri/sidecar"
  ],
  "scripts": {
    "dev": "bun run --filter @agent-terminal/desktop dev",
    "build": "bun run --filter @agent-terminal/desktop build",
    "tauri:dev": "bunx tauri dev --config src-tauri/tauri.dev.conf.json --features dev-instance",
    "tauri:build": "bunx tauri build",
    "lint": "biome check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint:fix": "biome check --write --unsafe && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --fix --allow-dirty --allow-staged",
    "typecheck": "bun run --filter @agent-terminal/desktop typecheck",
    "test": "bun test apps/desktop/src/ && cargo test --manifest-path src-tauri/Cargo.toml --lib && cargo test --manifest-path src-tauri/Cargo.toml --test hook_integration -- --test-threads=1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tauri-apps/cli": "^2"
  }
}
