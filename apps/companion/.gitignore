# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Common global gitignores (Python virtualenv `ENV/`) case-insensitively
# match src/modules/env/ on macOS. Un-ignore the source folder here so
# our env config modules always get tracked.
!src/modules/env/
!src/modules/env/**

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# fallow.tools local cache
.fallow/

# Native
.kotlin/
*.orig.*

# Signing material. An upload keystore and the properties file naming it
# are what Play checks every build against, so losing one blocks signed
# updates and leaking one lets someone else ship as us. They live outside
# the repo; these rules exist so a copy landing in the tree by accident
# cannot be staged. This repo is public.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
keystore.properties

# Play Store service account key. Named exactly rather than by extension:
# the tree is full of legitimate .json config that must stay tracked.
play-store-key.json
google-play-key.json
api-key.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files. `.env*.local` alone leaves a plain `.env` tracked,
# which is the file people actually paste tokens into.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle build output inside local Expo modules. Ephemeral, regenerated
# on every `expo run:android`, never committed. Also keeps biome + fallow
# from scanning it via their `useIgnoreFile` integration.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/local.properties

# Bundler vendors gems here whenever CI caches them. They are third-party
# Ruby packages that happen to ship JavaScript, and both biome and fallow
# read this .gitignore to decide what to scan: without this they lint and
# dead-code-analyse rdoc's syntax highlighter as if we wrote it.
vendor/

# Fastlane. `report.xml` and `Preview.html` are regenerated per run, and
# the metadata directories hold screenshots that belong to the store
# listing rather than to source.
fastlane/report.xml
fastlane/Preview.html
fastlane/*.log
fastlane/test_output/
fastlane/screenshots/
fastlane/*.json
