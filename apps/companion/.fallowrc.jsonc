{
  // Paths fallow should treat as reachable even without an explicit import
  // graph edge — normally used for framework-magic dynamic loads, borrowed
  // here for generated wire-protocol bindings that don't have a consumer
  // yet. The WSS client sub-step introduces the first import; when that
  // lands, this entry can go away.
  "dynamicallyLoaded": [
    "src/modules/wss/protocol.gen.ts",
    // Metro's platform resolution picks TerminalDom.android.tsx on Android
    // and TerminalDom.tsx on iOS/fallback. Fallow's import graph doesn't
    // model the platform split, so it flags the iOS file as unreachable.
    // Both are legitimate consumers.
    "src/screens/tab/TerminalDom.tsx",
    // Config plugins loaded by string reference from the plugins array in
    // app.config.ts (Expo's config-plugins mechanism). Fallow does not
    // follow that indirection, so it flags the files as unreachable.
    "plugins/withGradleWrapperVersion.js",
    "plugins/withIosDeploymentTarget.js",
    "plugins/withAndroidRelease.js"
  ],
  // react-native-web is required by expo/dom's `.web.tsx` files that
  // Metro pulls in when bundling `'use dom'` components. No source
  // file directly imports it; the bundler wires it transparently.
  // expo-build-properties + expo-dev-client + expo-system-ui are
  // autolinked / config-plugin loaded, so nothing imports them
  // directly. @expo/config-plugins is a transitive Expo dep required
  // from the local config plugins (build-time modules fallow does
  // not scan).
  // expo-font is the runtime the @react-native-vector-icons packages load
  // their font through, and a config plugin in app.config.ts. Expo's own
  // migration guide requires it to be installed; nothing imports it.
  "ignoreDependencies": [
    "expo-font",
    "react-native-web",
    "expo-build-properties",
    "expo-dev-client",
    "expo-system-ui",
    "@expo/config-plugins"
  ],
  "rules": {
    // `expo` is the Expo SDK runtime. It's imported transitively by
    // expo-router and directly by metro.config.js (build tooling). Fallow's
    // static analysis classifies metro.config.js as non-production and
    // doesn't follow the expo-router → expo edge, so it flags expo as
    // "test-only". False positive for the whole Expo ecosystem — expo is
    // the framework itself and cannot be moved to devDependencies.
    "test-only-dependencies": "off"
  },
  "health": {
    // Exempt files from the CRAP health gate. Fallow's default
    // maxCrap of 30 is aggressive for React component + state-machine
    // files whose complexity comes from stage/branch enumeration
    // (necessarily untested without a full render harness). The
    // pairing surface deliberately has one big state-machine
    // component; the underlying pure helpers ARE tested (see
    // resolver.test.ts, pair.helpers.test.ts). The `client.ts` file
    // is pre-existing; it grew slightly with the autoConnect / probe
    // helpers but stayed under the pre-Phase-2B risk envelope.
    "ignore": [
      // Four small pure predicates (shape guards, index reconciliation,
      // active-device selection) with direct unit tests in
      // $devices.helpers.test.ts. Fallow ESTIMATES CRAP from export
      // reference counts rather than measuring coverage, so a file with
      // several tested exports and several importers reads as untested
      // complexity. The flag is a coupling heuristic here, not a real
      // one: `fallow health --coverage` gives the true score.
      "src/modules/stores/$devices.helpers.ts",
      // Thin React glue around an async store read. The pure logic this
      // screen depends on (URL canonicalisation, fingerprint parsing,
      // device-record construction) is tested directly in
      // manual-pairing.helpers.test.ts; what remains here is an effect
      // that cannot be exercised without a full render harness.
      "src/screens/connect/manual-prefill.hooks.ts",
      "src/modules/wss/client.ts",
      "src/modules/wss/bootstrap.ts",
      "src/screens/pair/**",
      "src/screens/home/**",
      // A build-time config plugin: it runs during prebuild, never at
      // runtime, and nothing imports it, so the CRAP estimate reads it as
      // wholly untested complexity. Its complexity is four anchor checks
      // against Expo's Gradle template, each of which throws rather than
      // falling through, so template drift fails the build loudly instead
      // of silently producing an unsigned release. A unit test over the
      // patch function would still be worth having.
      "plugins/withAndroidRelease.js"
    ]
  }
}
