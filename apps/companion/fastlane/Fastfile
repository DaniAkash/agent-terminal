# Android lanes for the Agent Terminal companion.
#
# iOS is deliberately absent: those lanes need App Store Connect API and
# `match` credentials that do not exist yet. They land with the iOS pass
# rather than sitting here failing.

APP_DIR     = File.expand_path("..", __dir__)
ANDROID_DIR = File.join(APP_DIR, "android")
AAB_PATH    = File.join(ANDROID_DIR, "app", "build", "outputs", "bundle", "release", "app-release.aab")

# `apps/companion/package.json` is the single source of truth for the
# version, mirroring how the desktop app is released.
def package_version
  require "json"
  JSON.parse(File.read(File.join(APP_DIR, "package.json")))["version"]
end

# Play rejects a versionCode it has already accepted, so it has to rise on
# every upload. Deriving it from the version keeps the two in step and
# makes the number readable: 1.2.3 becomes 10203.
def derived_version_code(offset = 0)
  major, minor, patch = package_version.split(".").map(&:to_i)
  if minor > 99 || patch > 99
    UI.user_error!("version #{package_version} has a component above 99, which would break versionCode ordering")
  end
  (major * 10_000) + (minor * 100) + patch + offset.to_i
end

default_platform(:android)

platform :android do
  desc "Generate the native project and build a signed release AAB"
  lane :build do |options|
    version_code = options[:version_code] || derived_version_code(options[:build_offset] || 0)

    UI.message("version #{package_version}, versionCode #{version_code}")

    # Read by app.config.ts. The variant drops the `.dev` identifier
    # suffix; without it a production upload would carry the dev package.
    ENV["APP_VARIANT"] = "production"
    ENV["BUILD_NUMBER"] = version_code.to_s

    # --clean because a tree generated under the other variant keeps its
    # old applicationId, and that mistake only surfaces as a rejected
    # upload minutes later.
    # --no-install because dependencies are already installed by the time
    # this runs, locally and in CI alike, and letting prebuild run its own
    # package manager can leave package.json modified mid-build.
    Dir.chdir(APP_DIR) do
      sh("bunx", "expo", "prebuild", "--platform", "android", "--clean", "--no-install")
    end

    gradle(project_dir: ANDROID_DIR, task: "bundle", build_type: "Release")

    UI.user_error!("gradle reported success but no bundle exists at #{AAB_PATH}") unless File.exist?(AAB_PATH)
    UI.success("built #{AAB_PATH}")
    AAB_PATH
  end

  desc "Build and upload to the internal track"
  lane :internal do |options|
    deploy(options.merge(track: "internal"))
  end

  desc "Build and upload to the closed testing track (default: alpha)"
  lane :closed do |options|
    deploy(options.merge(track: options[:track] || "alpha"))
  end

  desc "Build and upload to production"
  lane :production do |options|
    deploy(options.merge(track: "production"))
  end

  desc "Build and dry-run the upload, without publishing anything"
  lane :validate do |options|
    deploy(options.merge(track: options[:track] || "internal", validate_only: true))
  end

  desc "Check the Play service account key is valid before trusting a release to it"
  lane :check_play_key do
    validate_play_store_json_key(json_key: ENV.fetch("PLAY_STORE_JSON_KEY"))
  end

  private_lane :deploy do |options|
    aab = build(options)

    # Metadata and images are skipped until the store listing is managed
    # from the repo. Uploading nothing is safer than uploading empty
    # directories, which `supply` treats as a request to blank the listing.
    upload_to_play_store(
      track: options[:track],
      aab: aab,
      release_status: options[:release_status] || "completed",
      # Runs the whole upload path against Play, auth, package match,
      # versionCode and signing key included, then discards the edit
      # instead of releasing. The cheapest way to find out that an upload
      # key does not match before it matters.
      validate_only: options[:validate_only].to_s == "true",
      # Without this supply also goes looking for APKs beside the bundle.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end
